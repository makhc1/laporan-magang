# Salin berkas ini menjadi .env.local atau .env:
# cp .env.example .env

# URL dan Publishable / Anon Key project Supabase kamu
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API Keys
# PENTING: Gunakan Publishable Key (sb_publishable_...) atau Legacy Anon Key (eyJ...),
# JANGAN gunakan Secret Key (sb_secret_...) karena diblokir Supabase di browser!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key-here

# Kredensial Super Admin (Opsional, default: admin / pkl2026)
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=pkl2026
