# Salin berkas ini menjadi .env.local atau .env:
# cp .env.example .env.local

# URL dan Anon Key project Supabase kamu
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Kredensial Super Admin (Opsional, default: admin / pkl2026)
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=pkl2026
